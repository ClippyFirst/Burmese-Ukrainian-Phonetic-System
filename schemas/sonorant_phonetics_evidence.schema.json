{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Burmese sonorant voicing and phonetics evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "dimension",
    "segment_class",
    "phonological_feature",
    "reported_phonetic_realization",
    "acoustic_cues",
    "study_context",
    "source_id",
    "claim_id",
    "source_locator",
    "scope_limit",
    "implementation_consequence",
    "runtime_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "inventory_summary",
        "experimental_scope",
        "realization_variability",
        "acoustic_contrast",
        "non_sg_correlates",
        "classifier_scope"
      ]
    },
    "segment_class": {
      "type": "string",
      "minLength": 1
    },
    "phonological_feature": {
      "type": "string",
      "minLength": 1
    },
    "reported_phonetic_realization": {
      "type": "string",
      "minLength": 1
    },
    "acoustic_cues": {
      "type": "string",
      "minLength": 1
    },
    "study_context": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "scope_limit": {
      "type": "string",
      "minLength": 1
    },
    "implementation_consequence": {
      "type": "string",
      "minLength": 1
    },
    "runtime_status": {
      "const": "WITHHELD"
    }
  }
}
