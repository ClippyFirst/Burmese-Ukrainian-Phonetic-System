{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurmeseOnsetClusterEvidence",
  "type": "object",
  "required": [
    "evidence_id",
    "domain",
    "structure",
    "environment",
    "attested_analysis",
    "source_id",
    "claim_id",
    "source_locator",
    "evidence_class",
    "profile_scope",
    "runtime_status",
    "implementation_consequence"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "onset_inventory",
        "prohibited_cluster",
        "cluster_distribution",
        "cluster_process",
        "attested_cluster",
        "medial_correspondence",
        "medial_inventory",
        "coda_inventory"
      ]
    },
    "structure": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "attested_analysis": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "source_analysis",
        "source_scoped_prohibition",
        "analysis_dependent",
        "attested_candidate",
        "descriptive_candidate",
        "orthographic_only",
        "historical_source_specific"
      ]
    },
    "profile_scope": {
      "type": "string",
      "minLength": 1
    },
    "runtime_status": {
      "const": "WITHHELD"
    },
    "implementation_consequence": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
